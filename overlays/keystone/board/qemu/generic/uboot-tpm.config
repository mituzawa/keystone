# U-Boot measured boot on the QEMU virt TPM (tcg,tpm-tis-mmio @ 0x10101000,
# provided by the buildroot fork's 0005-riscv-virt-add-tpm-support.patch).
#
# bootm_measure() extends: PCR8 <- kernel, PCR9 <- initrd, PCR1 <- bootargs,
# PCR0 <- DTB + CRTM version, PCR0-7 <- separators. It silently measures
# NOTHING unless the TPM DT node carries an event-log buffer
# (tpm_event_log_addr/size) — QEMU does not emit one, so preboot grafts it in.
# The control DT must be copied out first: reserve_fdt() relocates it with zero
# headroom, so an in-place "fdt resize" would clobber adjacent reservations.
# Event log at 0x82400000/64KiB: above OpenSBI's FDT staging (0x82200000),
# below kernel_addr_r (0x84000000).
# The Keystone SM PMP-protects [0x80000000, 0x80200000) (SMM_BASE/SMM_SIZE,
# sm/src/platform/generic/platform.h). The stock smode configs put the initial
# stack at TEXT_BASE, whose first push lands inside that window and faults
# before the console exists. 0x80600000 clears the window and both text bases
# (rv64 0x80200000, rv32 0x80400000), and is used pre-relocation only.
CONFIG_CUSTOM_SYS_INIT_SP_ADDR=0x80600000
CONFIG_TPM=y
CONFIG_TPM2_MMIO=y
CONFIG_CMD_TPM=y
CONFIG_MEASURED_BOOT=y
CONFIG_PREBOOT="cp.b ${fdtcontroladdr} ${fdt_addr_r} 0x10000; fdt addr ${fdt_addr_r}; fdt resize 0x1000; fdt set /soc/tpm@10101000 tpm_event_log_addr <0x0 0x82400000>; fdt set /soc/tpm@10101000 tpm_event_log_size <0x10000>; fdt addr -c ${fdt_addr_r}; setenv fdt_addr ${fdt_addr_r}"
# rootfs.ext2 is a bare filesystem with no partition table, which the distro
# boot partition scan refuses ("** No partition table **"); point sysboot at
# the whole device (part 0) instead.
CONFIG_USE_BOOTCOMMAND=y
CONFIG_BOOTCOMMAND="sysboot virtio 0:0 any ${scriptaddr} /boot/extlinux/extlinux.conf"
