# Keystone additions on top of the vendor eic7700 defconfig
# (eswincomputing/linux-stable). The keystone-driver allocates enclave
# memory from CMA; sizes match the hifive_unmatched configuration.
CONFIG_MODULE_UNLOAD=y
CONFIG_CMA=y
CONFIG_DMA_CMA=y
CONFIG_CMA_SIZE_MBYTES=1024
CONFIG_CMA_ALIGNMENT=9
