#!/bin/sh
#
# Blocks pushes that would update a shared branch directly, bypassing review.
#
# Enable once per clone:
#     git config core.hooksPath scripts/git-hooks
#
# See the "Git workflow" section of CLAUDE.md for the full policy.

red=''
bold=''
reset=''
if [ -t 2 ]; then
	red=$(printf '\033[31m')
	bold=$(printf '\033[1m')
	reset=$(printf '\033[0m')
fi

# git feeds one line per ref being pushed:
#     <local ref> <local sha> <remote ref> <remote sha>
status=0
while read -r _local_ref _local_sha remote_ref _remote_sha; do
	[ -n "$remote_ref" ] || continue

	case "$remote_ref" in
	refs/heads/master | refs/heads/main | refs/heads/dev)
		target=${remote_ref#refs/heads/}
		printf '%s%s✗ Refusing to push directly to '\''%s'\''.%s\n' \
			"$bold" "$red" "$target" "$reset" >&2
		printf '\n' >&2
		printf '  %s reaches %s only through a reviewed pull request.\n' \
			"This repository" "$target" >&2
		printf '  Push your feature branch instead, then open a PR:\n' >&2
		printf '\n' >&2
		printf '      git push -u origin feature/<member>/<topic>\n' >&2
		printf '      gh pr create --base %s\n' "$target" >&2
		printf '\n' >&2
		printf '  %s\n' "(intentional exception: git push --no-verify)" >&2
		status=1
		;;
	esac
done

exit $status
